{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "schedule": ["before 6am on monday"],
  "timezone": "Etc/UTC",
  "updateNotScheduled": false,
  "platformAutomerge": true,
  "automergeType": "pr",
  "packageRules": [
    {
      "description": "Test all non-major dependency updates together once a week",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "groupName": "weekly non-major dependencies",
      "groupSlug": "weekly-non-major",
      "automerge": true
    },
    {
      "description": "Replacement upgrades need separate review",
      "matchUpdateTypes": ["replacement"],
      "groupName": "replacement dependencies",
      "automerge": false
    },
    {
      "description": "Major upgrades always need review and stay outside the batch",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "automerge": false
    }
  ]
}
